         A)
     system calls required:
        open()
        read()
        write()
        close()
B)
    1. read() - reads data from a file
    2. write()- writes data into a file
C)
    #include <fcntl.h>
#include <unistd.h>

int main()
{
    int source, dest;
    char buffer[100];
    int n;

    // Open source file
    source = open("source.txt", O_RDONLY);

    // Create destination file
    dest = open("destination.txt", O_CREAT | O_WRONLY, 0644);

    // Copy contents
    while ((n = read(source, buffer, 100)) > 0)
    {
        write(dest, buffer, n);
    }

    // Close files
    close(source);
    close(dest);

    return 0;
}

question 4

A)
   fork() creates a new child process
   exec() replaces the current process with a new program
B)
   WAIT() makes the parent process wait until the child process completes execution
C)
   #include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    int pid;

    pid = fork();          // Create child process

    if (pid == 0)
    {
        // Child process
        execl("/bin/ls", "ls", NULL);   // Execute ls command
    }
    else
    {
        // Parent process
        wait(NULL);        // Wait for child to finish
        printf("Child process completed.\n");
    }

    return 0;
}

